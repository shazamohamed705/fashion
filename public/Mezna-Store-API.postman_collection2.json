          }
        },
        {
          "name": "Get Home (SEO) - الصفحة الرئيسية",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/page-contents/home",
            "description": "إعدادات SEO للصفحة الرئيسية (title, meta, og)."
          }
        }
      ]
    },
    {
      "name": "Hero Slides (صور الهيرو / الكاروسيل)",
      "item": [
