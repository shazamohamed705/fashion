          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/hero-slides",
            "description": "صور مفعلة بترتيب عشوائي (للكاروسيل في بداية الموقع). كل عنصر: id, image, alt_text, caption, sort_order."
          }
