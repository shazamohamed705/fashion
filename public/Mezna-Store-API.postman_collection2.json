            "url": {
              "raw": "{{base_url}}/api/banners?category_id=",
              "host": ["{{base_url}}"],
              "path": ["api", "banners"],
              "query": [
                { "key": "category_id", "value": "", "description": "فلترة حسب القسم" }
              ]
            }
          }
        },
        {
          "name": "Main Page Banners - بانرات الصفحة الرئيسية",
