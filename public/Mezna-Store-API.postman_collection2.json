            "url": "{{base_url}}/api/visits",
            "description": "تسجيل زيارة منتج. استبدل id بمعرف المنتج. اختياري: city, country, country_name."
          }
        }
      ]
    },
    {
      "name": "Remaining API Endpoints (التحديث والحذف والتفاصيل)",
      "description": "تكملة المسارات المعرفة في routes/api.php. املئي المتغيرات من طلبات الإنشاء أو أدخلي IDs موجودة. طلبات التعديل والحذف تتطلب token لمستخدم لديه صلاحية admin.",
      "item": [
        {
          "name": "Show Subcategory - عرض قسم فرعي",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/subcategories/{{subcategory_id}}"
          }
        },
        {
          "name": "List Brands - قائمة الماركات",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/brands"
          }
        },
        {
          "name": "Show Brand - عرض ماركة",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/brands/{{brand_id}}"
          }
        },
        {
          "name": "List Product Variants - قائمة خيارات المنتج",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/products/{{product_id}}/variants"
          }
        },
        {
          "name": "Show Product Variant - عرض خيار منتج",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/products/{{product_id}}/variants/{{variant_id}}"
          }
        },
        {
          "name": "Get Page Content By Key - جلب محتوى صفحة بالمفتاح",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{base_url}}/api/page-contents/{{page_key}}",
            "description": "غيّري page_key إلى مفتاح المحتوى المطلوب، مثل shipping أو returns أو faq أو home."
          }
        },
        {
          "name": "Update Category - تحديث قسم (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Category\",\n  \"is_active\": true,\n  \"hide_price\": false\n}" },
            "url": "{{base_url}}/api/categories/{{category_id}}"
          }
        },
        {
          "name": "Update Category - تحديث قسم (PATCH)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"is_active\": true\n}" },
            "url": "{{base_url}}/api/categories/{{category_id}}"
          }
        },
        {
          "name": "Delete Category - حذف قسم",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{base_url}}/api/categories/{{category_id}}"
          }
        },
        {
          "name": "Update Subcategory - تحديث قسم فرعي (PUT)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Updated Subcategory\",\n  \"default_image_source\": \"google_photos\",\n  \"is_active\": true\n}" },
            "url": "{{base_url}}/api/subcategories/{{subcategory_id}}"
          }
        },
        {
          "name": "Update Subcategory - تحديث قسم فرعي (PATCH)",
          "request": {
            "method": "PATCH",
